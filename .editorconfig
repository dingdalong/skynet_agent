# https://editorconfig.org/
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.lua]
# 这是 Lua 格式化器的扩展选项，关闭换行自动识别后，已有的 CRLF 也会按 end_of_line = lf 转成 LF。
detect_end_of_line = false

[*.md]
trim_trailing_whitespace = false

[*.yml]
indent_style = space
indent_size = 2

[*.{json,proto,yaml,yml}]
indent_style = space
indent_size = 2

[{makefile,Makefile}]
indent_style = tab
indent_size = 4
