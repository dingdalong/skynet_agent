{
    "runtime.version": "Lua 5.5",
    "runtime.path": [
        "?.lua",
        "?/init.lua",
        "?/?.lua"
    ],
    "workspace.library": [
        "server/src/lualib",
        "server/src/lualib/base",
        "server/src/service",
        "server/3rd/lua-openai",
        "server/3rd/lua-protobuf",
        "server/3rd/tableshape",
        "${3rd}/skynet/library",
        "${3rd}/busted/library",
        "${3rd}/luassert/library",
        "${3rd}/lfs/library"
    ],
    "workspace.checkThirdParty": "Apply",
    "workspace.ignoreDir": [
        ".vscode",
        "client",
        "server/cservice",
        "server/logs",
        "server/luaclib"
    ],
    "diagnostics.neededFileStatus": {
        "codestyle-check": "Any"
    },
    "diagnostics.globals": [
        "lfs",
        "SERVICE_NAME"
    ]
}
