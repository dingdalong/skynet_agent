{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@skynet/contracts": ["./packages/contracts/src/index.ts"],
      "@skynet/app-runtime": ["./packages/app-runtime/src/index.ts"],
      "@skynet/agent-client": ["./packages/agent-client/src/index.ts"],
      "@skynet/agent-client/*": ["./packages/agent-client/src/*"],
      "@skynet/app-sdk": ["./packages/app-sdk/src/bridge.ts"],
      "@skynet/app-sdk/react": ["./packages/app-sdk/src/react.tsx"],
      "@skynet/tokens": ["./packages/tokens/theme.ts"],
      "@skynet/workspace": ["./packages/workspace/src/Workspace.tsx"],
      "@skynet/workspace/platform": ["./packages/workspace/src/platform.tsx"],
      "@skynet/host-bridge": ["./packages/host-bridge/src/index.ts"]
    }
  },
  "include": ["apps/host/src", "builtins", "packages", "tooling"]
}
