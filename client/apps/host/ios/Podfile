require 'pathname'

ws_dir = Pathname.new(__dir__)
ws_dir = ws_dir.parent until
  File.exist?("#{ws_dir}/node_modules/react-native/scripts/react_native_pods.rb") ||
  ws_dir.expand_path.to_s == '/'
require "#{ws_dir}/node_modules/react-native/scripts/react_native_pods.rb"

platform :ios, '16.4'
prepare_react_native_project!

target 'SkynetHost-iOS' do
  Dir.chdir(File.expand_path('..', __dir__)) do
    use_native_modules!([
      'node', "#{ws_dir}/node_modules/@react-native-community/cli/build/bin.js",
      'config', '--platform', 'ios'
    ])
  end
  use_react_native!(
    :path => '../../../node_modules/react-native',
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )
  target 'SkynetHostTests' do
    inherit! :search_paths
  end
  post_install do |installer|
    react_native_post_install(installer, '../../../node_modules/react-native', :mac_catalyst_enabled => false)
  end
end
