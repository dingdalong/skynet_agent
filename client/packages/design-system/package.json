{
  "name": "@skynet/design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./style.css": "./src/styles/index.css",
    "./tokens.css": "./src/styles/tokens.css"
  },
  "scripts": {
    "tokens": "node scripts/generate-tokens.mjs",
    "tokens:check": "node scripts/generate-tokens.mjs --check && node scripts/check-token-usage.mjs",
    "build": "pnpm tokens && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev -p 16006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "lucide-vue-next": "^0.555.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.0.8",
    "@storybook/addon-docs": "^10.0.8",
    "@storybook/vue3-vite": "^10.0.8",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^27.2.0",
    "storybook": "^10.0.8",
    "vite": "^7.2.4",
    "vitest": "^4.0.14",
    "vue": "^3.5.24",
    "vue-tsc": "^3.1.4"
  }
}
