{
  "name": "@skynet/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:desktop": "node scripts/run-desktop.mjs dev",
    "proto:generate": "node scripts/generate-protocol.mjs",
    "proto:check": "node scripts/generate-protocol.mjs --check",
    "storybook": "pnpm --filter @skynet/design-system storybook",
    "build": "pnpm --filter @skynet/design-system build && pnpm build:app",
    "build:app": "vite build",
    "build:desktop": "node scripts/run-desktop.mjs build",
    "tokens": "pnpm --filter @skynet/design-system tokens",
    "tokens:check": "pnpm --filter @skynet/design-system tokens:check",
    "typecheck": "pnpm --filter @skynet/design-system typecheck && vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm --filter @skynet/design-system test && vitest run",
    "test:e2e": "playwright test",
    "check:native": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "test:native": "./tests/native/run-native.sh",
    "test:integration:native": "./tests/native/run-native.sh --integration",
    "test:integration:web": "sh ./tests/integration-web/run-integration.sh",
    "test:e2e:full": "./tests/e2e-fullstack/run-fullstack.sh",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm proto:check && pnpm tokens:check && pnpm typecheck && pnpm test && ./tools/check_format.sh",
    "tauri": "node scripts/run-desktop.mjs",
    "test:execution": "sh tests/execution/run.sh"
  },
  "dependencies": {
    "@skynet/design-system": "workspace:*",
    "@tauri-apps/api": "^2.9.1",
    "lucide-vue-next": "^0.555.0",
    "pinia": "^3.0.4",
    "protobufjs": "^8.8.1",
    "reka-ui": "^2.6.1",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@tauri-apps/cli": "^2.9.4",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.6.2",
    "jsdom": "^27.2.0",
    "prettier": "^3.7.4",
    "protobufjs-cli": "^2.7.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.2.4",
    "vitest": "^4.0.14",
    "vue-tsc": "^3.1.4"
  }
}
