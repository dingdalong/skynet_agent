{
  "name": "skynet-client",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "format": "prettier --write apps/host/src builtins packages tooling vitest.config.mts && node tooling/format-native.mjs",
    "format:check": "prettier --check apps/host/src builtins packages tooling vitest.config.mts && node tooling/format-native.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:boundaries": "node tooling/check-boundaries.mjs",
    "build:apps": "node tooling/build-apps.mjs",
    "build:host": "node tooling/build.mjs build",
    "dev": "node tooling/build.mjs dev",
    "test:core": "node tooling/test-core.mjs",
    "platforms": "node tooling/build.mjs list",
    "doctor": "node tooling/build.mjs doctor",
    "probe:platforms": "node tooling/probe-platforms.mjs",
    "shadcn": "shadcn"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-macos": "0.83.0"
  },
  "devDependencies": {
    "@babel/runtime": "7.29.14",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.83.10",
    "@react-native/community-cli-plugin": "0.83.10",
    "@react-native/metro-config": "0.83.10",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "clsx": "2.1.1",
    "esbuild": "0.28.2",
    "lucide-react": "1.72.0",
    "prettier": "3.10.1",
    "shadcn": "4.23.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "ws": "8.23.0",
    "zod": "4.6.7"
  }
}
