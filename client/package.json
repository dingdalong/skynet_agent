{
  "name": "skynet-client",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "protocol:generate": "node tooling/generate-protocol.mjs",
    "protocol:check": "node tooling/generate-protocol.mjs --check",
    "format": "prettier --write apps/host/src builtins packages tooling vitest.config.mts && node tooling/format-native.mjs",
    "format:check": "prettier --check apps/host/src builtins packages tooling vitest.config.mts && node tooling/format-native.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:boundaries": "node tooling/check-boundaries.mjs",
    "build:apps": "node tooling/build-apps.mjs",
    "build:host": "node tooling/build.mjs build",
    "dev": "node tooling/build.mjs dev",
    "test:core": "node tooling/test-core.mjs",
    "platforms": "node tooling/build.mjs list",
    "doctor": "node tooling/build.mjs doctor"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.16",
    "@astryxdesign/theme-neutral": "0.7.16",
    "@heroicons/react": "2.2.0",
    "@kayahr/text-encoding": "2.2.0",
    "@stylexjs/stylex": "^0.19.2",
    "protobufjs": "8.8.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.16",
    "@types/node": "26.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "esbuild": "0.28.2",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "ws": "8.23.0"
  }
}
