root = "./"
skynet_root = root .. "3rd/skynet/"

thread = 2
logpath = "."
harbor = 0
start = "protobuf_shared_owner"
bootstrap = "snlua bootstrap"
cpath = skynet_root .. "cservice/?.so"

luaservice = root .. "tests/integration/?.lua;" .. skynet_root .. "service/?.lua;"
lualoader = skynet_root .. "lualib/loader.lua"
preload = root .. "src/lualib/base/preload.lua"
lua_path = skynet_root .. "lualib/?.lua;" .. skynet_root .. "lualib/?/init.lua;" ..
    root .. "src/lualib/?.lua;" .. root .. "src/lualib/?/init.lua;" ..
    root .. "src/lualib/base/?.lua;" ..
    root .. "src/service/?/?.lua;" ..
    root .. "3rd/lua-protobuf/?.lua;" .. root .. "3rd/lua-protobuf/?/init.lua;"
lua_cpath = skynet_root .. "luaclib/?.so;" .. root .. "luaclib/?.so"
