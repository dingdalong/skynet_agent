#!/usr/bin/env python3
import argparse
import json
import os
from pathlib import Path
import subprocess

parser = argparse.ArgumentParser(description="向 App Center 提交本地镜像")
submit = parser.add_subparsers(dest="command", required=True).add_parser("submit")
for field in ("app-id", "name", "image"):
    submit.add_argument("--" + field, required=True)
args = parser.parse_args()
root = Path(__file__).resolve().parents[1]
result = subprocess.run(["docker", "compose", "--env-file", os.environ.get("SKYNET_ENV_FILE", "server/.env"),
                         "exec", "-T", "app-center", "./3rd/skynet/skynet", "etc/config.submit"],
                        input=json.dumps(vars(args)), text=True, cwd=root)
raise SystemExit(result.returncode)
